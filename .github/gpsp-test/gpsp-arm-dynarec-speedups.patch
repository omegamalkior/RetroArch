+                    &to_slow_smc);
+    if (cs->keep_flags) {
+      ARM_MSR_REG(0, ARM_PSR_F, reg_a2, ARM_CPSR);
+    }
+    back = translation_ptr;
+    ARM_B(0, 0);
+    generate_branch_patch_unconditional(back, cs->ret);
