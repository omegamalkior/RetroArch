+    }
+    emit_mem_handler_call(&translation_ptr, cs->kind, cs->store, cs->pcword);
+    back = translation_ptr;
+    ARM_B(0, 0);
+    generate_branch_patch_unconditional(back, cs->ret);
+  }
+  cold_stub_count = 0;
+  *tptr = translation_ptr;
