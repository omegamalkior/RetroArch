 }
 
 #ifdef __arm__
+#ifdef HAVE_ARMV6
+// Flat lighting depends only on the CLUT entry, so light the CLUT once per
+// primitive and draw its spans with the unlit asm. Rebuilt when the
+// primitive, CLUT or light changes; not used for a span that draws over
+// the CLUT, or when lighting makes a nonzero entry 0.
+u32 poly_lit_clut_serial;
+
+static noinline const le16_t *PolyLitClut(const gpu_unai_inner_t &inn,
+	const le16_t *pDst, u32 count, int bpp)
+{
+	static const u32 idx4[2] = { 0x76543210, 0xfedcba98 };
+	static u8 idx8[256] __attribute__((aligned(4)));
+	static le16_t lut[256] __attribute__((aligned(32)));
+	static struct { const le16_t *cba; u32 rgb, serial; int bpp; bool ok; } c;
+	int i, n = bpp == 4 ? 16 : 256;
+
+	if (inn.CBA < pDst + count && pDst < inn.CBA + n) {
+		c.cba = NULL;
+		return NULL;
+	}
+	if (c.cba == inn.CBA && c.rgb == inn.bgr0888 && c.bpp == bpp
+	    && c.serial == poly_lit_clut_serial)
+		return c.ok ? lut : NULL;
+	if (count < 8)
+		return NULL;
+
+	gpu_unai_inner_t li = inn;
+	li.TBA = (le16_t *)(bpp == 4 ? (const void *)idx4 : (const void *)idx8);
+	li.u = 0;
+	li.v = 0;
+	li.u_inc = 1 << 10;
+	li.v_inc = 0;
+	li.mask_v00u = 0xff;
+	memset(lut, 0, n * sizeof(lut[0]));
+	if (bpp == 4)
+		poly_4bp_l1d0m0std_asm(lut, &li, n);
+	else {
+		if (!idx8[255])
+			for (i = 0; i < 256; i++)
+				idx8[i] = i;
+		poly_8bp_l1d0m0std_asm(lut, &li, n);
+	}
+	c.ok = true;
+	for (i = 0; i < n; i++)
+		if (!le16_raw(lut[i]) && le16_raw(inn.CBA[i]))
+			c.ok = false;
+	c.cba = inn.CBA;
+	c.rgb = inn.bgr0888;
+	c.bpp = bpp;
+	c.serial = poly_lit_clut_serial;
+	return c.ok ? lut : NULL;
+}
+#endif
+
